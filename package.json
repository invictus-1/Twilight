{
  "name": "twilight",
  "productName": "Twilight",
  "version": "0.2.0",
  "description": "A fast, local-first desktop front end for language models, agents and writing.",
  "private": true,
  "main": "out/main/index.js",
  "author": "Twilight",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0",
    "markdown-it": "14.3.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "app.twilight.desktop",
    "productName": "Twilight",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Twilight-${version}-${arch}.${ext}",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Twilight",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "runAfterFinish": true,
      "artifactName": "Twilight-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "invictus-1",
      "repo": "twilight-releases"
    }
  }
}
